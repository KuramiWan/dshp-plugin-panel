#!/usr/bin/env bash
#
# dsh-dev / dsh-test —— 开发/测试环境启动器（单命令拉起独立 DSH 内核）
#
# 架构（2026-08 定案）：一个 dsh 内核，多个 DSH_HOME 根隔离环境。
#   - 生产：DSH_HOME=~/.dsh，--profile web（npm 面板，真实数据）
#   - 开发：DSH_HOME=<项目>/.dsh-dev，--profile web（官方模板，
#     base+web-app+面板，与生产同组合；差异只在 patch 内容）
#   - 凭证/模型配置共享：patch 里 config.path 指向生产 settings.yaml /
#     .credentials.yaml（零复制、零软链、换机器免配）
#
# 用法：
#   ./dsh-dev --port 3181          # 开发（web profile，无 fixtures）
#   ./dsh-test --port 3182         # 测试（web profile + fixtures patch）
#   ./dsh-dev --dump-config        # 查看开发组合（不启动）
#   ./dsh-dev --profile web ...    # 透传（默认已带 --profile web）
#
# 前置：先运行「构建」一次（见 README Development environments）：
#   DSH_HOME=$PWD/.dsh-dev dsh plugin --profile web add "$PWD"
#   （在仓库根执行；本脚本只负责启动/补全，不负责首次构建）

set -euo pipefail

# ---- 0. 环境选择 ----
SCRIPT_NAME="$(basename "$0")"
case "$SCRIPT_NAME" in
  dsh-dev)  MODE="dev" ;;
  dsh-test) MODE="test" ;;
  *) echo "usage: 以 dsh-dev 或 dsh-test 命名本脚本"; exit 2 ;;
esac

# ---- 1. 定位（脚本与 .dsh-dev 都在仓库根，随仓库走） ----
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEV_HOME="$PROJECT_ROOT/.dsh-dev"
# 官方 web profile（与生产同组合；dev/test 差异只在 patch 内容）
PROFILE_NAME="web"
PROFILE_DIR="$DEV_HOME/profiles/$PROFILE_NAME"
PATCH_FILE="$PROFILE_DIR/cordis.patch.yml"

# ---- 2. 校验开发/测试根已构建 ----
# 注意：.dsh-dev 是 dev/test 共用根（一个 DSH_HOME 装两种模式，差异只在
# patch 内容），不是「先跑 dev 才能跑 test」的双 profile 结构。
if [ ! -f "$PROFILE_DIR/package.json" ]; then
  echo "错误: 测试/开发根未构建。请先在仓库根执行:" >&2
  echo "  DSH_HOME=\"\$PWD/.dsh-dev\" dsh plugin --profile $PROFILE_NAME add \"\$PWD\"" >&2
  echo "  （web 是官方模板，自动带 dsh-base + dsh-web-app，与生产同组合）" >&2
  exit 1
fi

# ---- 2.5 自动补全凭证/设置共享（幂等） ----
# dsh plugin add 生成的 patch 是空模板（顶层裸 []）；此处把「模型配置/凭证
# 跨根共享」（config.path 指向生产 ~/.dsh 文件）写进 patch。已有则跳过。
# 注意：裸 [] 后不能直接追加 YAML 条目（非法文档），先剔除裸 [] 行。
if ! grep -q "id: credentials" "$PATCH_FILE" 2>/dev/null; then
  # 剔除「仅含 []」的空文档行（顶层裸 []），保证后续条目合法
  if [ -f "$PATCH_FILE" ]; then
    grep -v '^\s*\[\]\s*$' "$PATCH_FILE" > "$PATCH_FILE.tmp" || true
    mv "$PATCH_FILE.tmp" "$PATCH_FILE"
  fi
  cat >> "$PATCH_FILE" <<EOF

# 共享生产模型配置与凭证（config.path 指向生产 ~/.dsh，零复制零软链）
- id: settings
  config:
    path: $HOME/.dsh/settings.yaml

- id: credentials
  config:
    path: $HOME/.dsh/.credentials.yaml
EOF
  echo "已补全开发根凭证/设置共享（指向生产 ~/.dsh）"
fi

# ---- 2.6 自动补全 web-app bundle（幂等） ----
# 风险回归防护（052e220 重构曾删掉 708aa20 的修复，见 issue #1）：
# dsh plugin add 在 profile 模板不带 web-app 时，生成的 bundles 只有
# dsh-base + 面板，缺 @deepseek-ai/dsh-web-app（提供 webServer HTTP 服务）
# 会导致面板 initialized 后无 web 层、进程静默挂起（无监听、无报错）。
# 官方 web 模板通常自带 web-app，此处仅为「模板组合变化」兜底：已有则跳过，
# 缺则幂等补入（web-app 是内核自带，全局安装可直接解析，无需 pnpm 装）。
PKG_FILE="$PROFILE_DIR/package.json"
if ! grep -q 'dsh-web-app' "$PKG_FILE" 2>/dev/null; then
  node -e '
    const fs = require("fs");
    const file = process.argv[1];
    const pkg = JSON.parse(fs.readFileSync(file, "utf8"));
    const bundles = pkg.dsh?.profile?.bundles ?? [];
    if (!bundles.includes("@deepseek-ai/dsh-web-app")) {
      bundles.splice(1, 0, "@deepseek-ai/dsh-web-app");
      fs.writeFileSync(file, JSON.stringify(pkg, null, 2) + "\n");
      process.stdout.write("已补全 web-app bundle（webServer 服务）\n");
    }
  ' "$PKG_FILE"
fi

# ---- 2.7 测试模式：自动补全 fixtures patch（幂等） ----
# dsh-test = web profile + fixtures（dshp-test-plugin 热插拔行 +
# test-mcp-stdio MCP 桥接行）。test-plugin 需真副本进 profile node_modules。
if [ "$MODE" = "test" ]; then
  # a. test-plugin 真副本（若缺）
  if [ ! -d "$PROFILE_DIR/node_modules/dshp-test-plugin" ]; then
    if [ -d "$PROJECT_ROOT/test/fixtures/test-plugin" ]; then
      mkdir -p "$PROFILE_DIR/node_modules"
      cp -r "$PROJECT_ROOT/test/fixtures/test-plugin" "$PROFILE_DIR/node_modules/dshp-test-plugin"
      echo "已装入 test-plugin fixture（真副本）"
    fi
  fi
  # b. fixtures patch 行（若缺）
  if ! grep -q "dshp-test-plugin" "$PATCH_FILE" 2>/dev/null; then
    cat >> "$PATCH_FILE" <<'EOF'

# fixtures：dshp-test-plugin 热插拔行 + test-mcp-stdio MCP 桥接行
- insert:
    - id: dshp-test-plugin
      name: dshp-test-plugin
    - id: test-mcp-stdio
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        serverName: test-mcp-stdio
        transport: stdio
        command: __nonexistent_fixture_server__
        args: []
EOF
    echo "已补全 fixtures patch（dshp-test-plugin + test-mcp-stdio）"
  fi
fi

# ---- 3. 启动（开发根，生产 ~/.dsh 只读） ----
export DSH_HOME="$DEV_HOME"
# 用户显式 --profile 优先，否则默认 web profile
if printf '%s\n' "$@" | grep -q -- "--profile"; then
  exec dsh "$@"
else
  exec dsh --profile "$PROFILE_NAME" "$@"
fi
