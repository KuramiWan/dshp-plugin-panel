#!/usr/bin/env bash
#
# dsh-dev / dsh-test —— dev/test 环境的 DSH 启动封装。
#
# 方案（grilling 定案，2026-08）：官方 profile 机制。
#   - 一个 DSH home（~/.dsh），dev/test 各自是独立 profile
#   - 凭证/会话/设置共享（profile 机制天然如此），无需 --with-creds 注入
#   - 隔离在组合层（node_modules + bundles + cordis.patch.yml 各自独立）
#   - --with-creds 保留为兼容（旧 DSH_HOME 方案的注入逻辑），新方案下无必要
#
# 用法：
#   ./dsh-dev --port 3091          # 启动 dev profile
#   ./dsh-test --port 3092         # 启动 test profile
#   ./dsh-test --dump-config       # 查看 test 组合树（不启动）
#   ./dsh-dev --profile dev ...    # （透传，wrapper 已带 --profile）
#
# 前置：先运行 setup-env.sh <dev|test> 搭建对应 profile。

set -euo pipefail

# ---- 0. 环境选择 ----
SCRIPT_NAME="$(basename "$0")"
case "$SCRIPT_NAME" in
  dsh-dev)  ENV_NAME="dev" ;;
  dsh-test) ENV_NAME="test" ;;
  *) echo "usage: 以 dsh-dev 或 dsh-test 命名本脚本（或 symlink）"; exit 2 ;;
esac

# ---- 1. 定位 ----
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DSH_HOME_TARGET="${DSH_HOME_TARGET:-$HOME/.dsh}"

# ---- 2. 透传参数（用户显式传 --profile 时以用户的为准） ----
ARGS=()
for arg in "$@"; do
  case "$arg" in
    # 兼容旧用法：--with-creds 在新方案下无意义（凭证共享），静默接受
    --with-creds) : ;;
    *) ARGS+=("$arg") ;;
  esac
done

# ---- 3. 校验 profile 已搭建 ----
if [ ! -f "$DSH_HOME_TARGET/profiles/$ENV_NAME/package.json" ]; then
  echo "错误: profile $ENV_NAME 未搭建。请先运行 setup-env.sh $ENV_NAME" >&2
  exit 1
fi

# ---- 4. 启动 ----
export DSH_HOME="$DSH_HOME_TARGET"
# 用户显式 --profile 优先，否则用本脚本对应 profile
if printf '%s\n' "${ARGS[@]}" | grep -q -- "--profile"; then
  exec dsh "${ARGS[@]}"
else
  exec dsh --profile "$ENV_NAME" "${ARGS[@]}"
fi
