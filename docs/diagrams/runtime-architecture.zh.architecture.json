  "cards": [
    {
      "dot": "cyan",
      "title": "三面同源",
      "items": [
        "面板、/skill-* 命令与 session_skill_* 工具共享同一 SessionSkillStore",
        "技能与 MCP 都是会话级能力，活在 agent 上下文里，按会话隔离",
        "引入 = 纯注册：resourceBase 指回池目录，不复制文件"
      ]
    },
    {
      "dot": "emerald",
      "title": "两种挂载",
      "items": [
        "patch：cordis.patch.yml insert 行，watcher 热重载，改即生效",
        "bundle：dsh.profile.bundles 启动读一次，改动需重启",
        "面板自身也由组合层挂载（bootstrap）"
      ]
    },
    {
      "dot": "rose",
      "title": "写保护与安全",
      "items": [
        "每次写：.bak 备份 → 解析校验 → 临时文件 + rename 原子写",
        "失败回滚；mcp select 失败时 restoreGlobalMcp",
        "promote 就地改写 node_modules 内声明，pnpm update 会还原"
      ]
    },
    {
      "dot": "violet",
      "title": "会话隔离",
      "items": [
        "引入集落盘 <poolRoot>/.session-skills/<sessionId>.json",
        "仅 source==='resume' 的会话重放，新会话不重放",
        "同名 skill 本会话影子覆盖全局版本"
      ]
    }
  ]
