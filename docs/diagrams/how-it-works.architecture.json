      "fromSide": "bottom",
      "toSide": "right"
    },
    {
      "id": "skill-pool",
      "from": "skill",
      "to": "pool",
      "label": "register, no copy",
      "fromSide": "right",
      "toSide": "left"
    },
    {
      "id": "skill-sessionfile",
      "from": "skill",
      "to": "sessionfile",
      "label": "persist",
      "fromSide": "bottom",
      "toSide": "left"
    },
    {
      "id": "bundle-promote",
      "from": "bundle",
      "to": "patch",
      "label": "promote",
      "fromSide": "top",
      "toSide": "bottom"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Everything is a plugin",
      "items": [
        "Every capability is a loadable row in the DSH composition",
        "Skill = document capability, MCP = mcp-client row",
        "Host plugin = patch or bundle row"
      ]
    },
    {
      "dot": "emerald",
      "title": "Two mount dimensions",
      "items": [
        "Session-level lives in the agent context, isolated per session",
        "Process-level host plugins load into the host and affect everything",
        "The Skills / Plugins split is presentation: one layer underneath"
      ]
    },
    {
      "dot": "violet",
      "title": "Introduce = register",
      "items": [
        "The registration points back at the pool folder; no file is copied",
        "Saved to <poolRoot>/.session-skills/<sessionId>.json",
        "Replayed when a resumed session comes back after a restart"
      ]
    }
  ]
}
