  "cards": [
    {
      "dot": "cyan",
      "title": "Three faces, one core",
      "items": [
        "Panel, /skill-* commands, and session_skill_* tools share one SessionSkillStore",
        "Skills and MCP are session-level; both live in the agent context",
        "Introduce is pure registration: resourceBase points back at the pool"
      ]
    },
    {
      "dot": "emerald",
      "title": "Two kinds of mount",
      "items": [
        "patch: cordis.patch.yml insert row, watcher hot reload",
        "bundle: dsh.profile.bundles, read at startup, needs a restart",
        "The panel itself is mounted by the same composition layer"
      ]
    },
    {
      "dot": "rose",
      "title": "Write protection",
      "items": [
        "Every write: .bak backup → parse check → temp file + rename",
        "Failure rolls back; mcp select restores the global row",
        "promote edits node_modules in place; pnpm update reverts it"
      ]
    },
    {
      "dot": "violet",
      "title": "Session isolation",
      "items": [
        "Introduce-set lands in <poolRoot>/.session-skills/<sessionId>.json",
        "Only sessions starting with source==='resume' replay it",
        "A same-name skill shadows the global one in that session only"
      ]
    }
  ]
