{
  "name": "@super_camel/dsh-skill-panel",
  "description": "DSHP session-scoped skill control and plugin management: session_skill_* tools, /skill-* commands, and a browser panel for skills, session MCP, and host-composition plugins (enable/disable, bundle→patch promote)",
  "version": "0.2.0",
  "license": "MIT",
  "author": "super_camel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KuramiWan/dshp-skill-panel.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:host": "node build-client.mjs --host",
    "build:client": "node build-client.mjs",
    "build": "pnpm run build:host && pnpm run build:client",
    "check:name": "node scripts/check-name.mjs",
    "debug": "node --experimental-strip-types scripts/debug-dump.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck:host": "tsc -p tsconfig.host.json --noEmit",
    "typecheck:client": "tsc -p tsconfig.client.json",
    "typecheck": "pnpm run typecheck:host && pnpm run typecheck:client",
    "prepublishOnly": "pnpm run check:name && pnpm run test && pnpm run typecheck && pnpm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "dependencies": {
    "js-yaml": "^4.3.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-mcp-client": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-skill": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-mcp-client": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-skill": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.5.0"
  }
}